# Same wallet used to deploy the contracts works fine here too — the worker only needs gas
# money on Creditcoin CC3 Testnet to submit `execute()` calls. It never touches player funds.
CREDITCOIN_WALLET_PRIVATE_KEY=0xyour_private_key_here

SOURCE_CHAIN_RPC_URL=https://sepolia.infura.io/v3/your_infura_key
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network/

# Chain key Creditcoin uses to identify Sepolia as a source chain (see Attestcoin Protocol docs:
# CC3 Testnet -> Ethereum Sepolia = chain key 1).
SOURCE_CHAIN_KEY=1

# Leave blank to auto-load from ../deployed-addresses.json (written by the contracts package's
# deploy scripts). Set explicitly to override.
TERRA_SESSION_CONTRACT_ADDRESS=
TERRA_CHAIN_GAME_CONTRACT_ADDRESS=

# How many sessions this relayer will wait-for-attestation on at the same time. Raise this on a
# beefier host if you're relaying for many concurrent players; each one is a long-lived poll
# against PROOF_BUILDER_URL, not much CPU/memory, so it scales cheaply. Default: 20.
MAX_CONCURRENT_SESSIONS=20
