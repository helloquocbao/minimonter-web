# Wallet used to deploy + wire contracts on BOTH Sepolia and Creditcoin CC3 Testnet.
# Generate a fresh one (never reuse a wallet with real funds): `cast wallet new` or any EVM wallet tool.
CREDITCOIN_WALLET_PRIVATE_KEY=0xyour_private_key_here

# Sepolia RPC (e.g. from Infura/Alchemy). This is the "source chain".
SOURCE_CHAIN_RPC_URL=https://sepolia.infura.io/v3/your_infura_key

# Creditcoin CC3 Testnet RPC. This is the "execution chain" where the game lives.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Filled in after each deploy step (see README.md).
TERRA_SESSION_CONTRACT_ADDRESS=
TERRA_TOKEN_CONTRACT_ADDRESS=
TERRA_CHAIN_GAME_CONTRACT_ADDRESS=
