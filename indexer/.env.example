CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Leave blank to auto-load from ../deployed-addresses.json.
TERRA_CHAIN_GAME_CONTRACT_ADDRESS=

# Block to start replaying events from on first run (the contract's deploy block — check
# deployed-addresses.json or your deploy tx). Defaults to 0, which works but does one slow full
# chunked scan from genesis on first boot. State is kept in memory only — every restart replays
# from this block again (no database to persist a "resume point" across restarts in this MVP).
INDEXER_START_BLOCK=0

# Port the read API listens on.
PORT=4000
